STRATA_PROVIDER=gemini
GEMINI_BACKEND=aistudio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2-vision

STRATA_PAGES_PER_REQUEST=50
STRATA_CLAIMS_PER_PAGE=8
STRATA_REQUEST_SPACING_S=12

STRATA_DB=sqlite
STRATA_DB_PATH=data/strata.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

STRATA_CACHE_DIR=data/cache
STRATA_CACHE_ENABLED=1

STRATA_MAX_UPLOAD_MB=20
STRATA_MAX_UPLOAD_PAGES=100
